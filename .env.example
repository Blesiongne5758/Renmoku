# ============================================================================
# RENMOKU — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@localhost:5432/renmoku?schema=public"

# Prisma Configuration
PRISMA_BINARY_TARGET="native"

# ============================================================================
# APPLICATION
# ============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# JWT Expiration
JWT_EXPIRES_IN="7d"

# Refresh Token Expiration
REFRESH_TOKEN_EXPIRES_IN="30d"

# ============================================================================
# PAYMENT GATEWAY (Midtrans)
# ============================================================================

# Midtrans Server Key (from Midtrans Dashboard)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"

# Midtrans Client Key
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"

# Midtrans Environment (true = production, false = sandbox)
MIDTRANS_IS_PRODUCTION="false"

# ============================================================================
# CLOUD STORAGE (AWS S3 / Cloudflare R2)
# ============================================================================

# AWS S3 Configuration
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="renmoku-documents"
AWS_S3_ENDPOINT="https://s3.ap-southeast-1.amazonaws.com"

# Cloudflare R2 (Alternative)
# R2_ACCOUNT_ID="your-r2-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET="renmoku-documents"
# R2_PUBLIC_URL="https://your-r2-public-url.com"

# ============================================================================
# EMAIL SERVICE (SendGrid / Resend)
# ============================================================================

# SendGrid Configuration
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@renmoku.id"
SENDGRID_FROM_NAME="Renmoku"

# Resend (Alternative)
# RESEND_API_KEY="your-resend-api-key"
# RESEND_FROM_EMAIL="noreply@renmoku.id"

# ============================================================================
# SMS SERVICE (Twilio / Fonnte)
# ============================================================================

# Twilio Configuration
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Fonnte (Indonesia WhatsApp Gateway)
# FONNTE_TOKEN="your-fonnte-token"
# FONNTE_DEVICE="your-fonnte-device"

# ============================================================================
# NOTIFICATION SERVICE
# ============================================================================

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# OneSignal (Alternative)
# ONESIGNAL_APP_ID="your-onesignal-app-id"
# ONESIGNAL_API_KEY="your-onesignal-api-key"

# ============================================================================
# EXTERNAL APIS
# ============================================================================

# Google Maps API
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Geocoding API (Nominatim / Google)
GEOCODING_PROVIDER="google" # or "nominatim"

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================

# Sentry (Error Tracking)
SENTRY_DSN="your-sentry-dsn"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# PostHog (Product Analytics)
# NEXT_PUBLIC_POSTHOG_KEY="your-posthog-key"
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ============================================================================
# RATE LIMITING
# ============================================================================

# Redis Configuration (for rate limiting & caching)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="your-redis-password"

# Rate Limit Settings
RATE_LIMIT_WINDOW_MS="900000" # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"

# ============================================================================
# SECURITY
# ============================================================================

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,https://renmoku.id"

# CSRF Secret
CSRF_SECRET="your-csrf-secret"

# Encryption Key (for sensitive data)
ENCRYPTION_KEY="your-encryption-key-32-chars-long"

# ============================================================================
# LOGGING
# ============================================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL="info"

# Log Format (json, pretty)
LOG_FORMAT="pretty"

# ============================================================================
# FILE UPLOAD
# ============================================================================

# Maximum file size (in bytes)
MAX_FILE_SIZE="10485760" # 10MB

# Allowed file types
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# ============================================================================
# BUSINESS LOGIC
# ============================================================================

# Default DP Percentage
DEFAULT_DP_PERCENTAGE="30"

# Platform Fee (percentage from owner revenue)
PLATFORM_FEE_PERCENTAGE="10"

# Tax Rate (PPN)
TAX_RATE="11"

# Minimum Renter Age
MIN_RENTER_AGE="21"

# ============================================================================
# DEVELOPMENT
# ============================================================================

# Enable debug mode
DEBUG="false"

# Mock payment (skip actual payment gateway)
MOCK_PAYMENT="true"

# Skip email verification
SKIP_EMAIL_VERIFICATION="true"

# ============================================================================
# END OF ENVIRONMENT VARIABLES
# ============================================================================
