# ============================================================================
# RENMOKU FRONTEND - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================

# Supabase Project URL
# Get this from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Public)
# Get this from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# CLOUDINARY CONFIGURATION
# ============================================================================

# Cloudinary Cloud Name
# Get this from: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API Key
# Get this from: https://cloudinary.com/console
VITE_CLOUDINARY_API_KEY=your-api-key

# Cloudinary Upload Preset (Unsigned)
# Create at: https://cloudinary.com/console/settings/upload
VITE_CLOUDINARY_UPLOAD_PRESET=renmoku_preset

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Backend API URL (if using separate backend)
# For InfinityFree deployment, this might be different
VITE_API_URL=https://your-backend-url.com/api/v1

# Socket.io URL (if using real-time features)
VITE_SOCKET_URL=https://your-backend-url.com

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application URL (for PWA and OAuth redirects)
VITE_APP_URL=https://your-domain.infinityfreeapp.com

# Application Environment
VITE_APP_ENV=production

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/Disable Features
VITE_ENABLE_PWA=true
VITE_ENABLE_I18N=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CRYPTO_WALLET=false

# ============================================================================
# THIRD-PARTY SERVICES
# ============================================================================

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry Error Tracking (optional)
VITE_SENTRY_DSN=https://your-sentry-dsn

# Midtrans Payment Gateway (optional)
VITE_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
VITE_MIDTRANS_IS_PRODUCTION=false

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Enable debug mode
VITE_DEBUG=false

# Log level
VITE_LOG_LEVEL=info

# ============================================================================
# NOTES FOR INFINITYFREE DEPLOYMENT
# ============================================================================

# InfinityFree Limitations:
# - No server-side processing (PHP only)
# - Limited bandwidth (unlimited but fair use)
# - No Node.js support
# - No WebSocket support
# - Limited database (MySQL only)
#
# Recommended Setup:
# 1. Frontend: InfinityFree (static hosting)
# 2. Database: Supabase (free tier)
# 3. File Storage: Cloudinary (free tier)
# 4. Auth: Supabase Auth (free tier)
# 5. Real-time: Supabase Realtime (free tier)
#
# Build Command:
# npm run build
#
# Upload to InfinityFree:
# Upload contents of /dist folder via FTP or File Manager
